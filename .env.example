# Core application (private values; use an isolated local database for development)
MONGODB_URI=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
SITE_URL=http://localhost:3000

# Product and blog uploads (server only)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# POS integration (never commit a real pepper or a raw device token)
POS_TOKEN_PEPPER=
POS_SALES_ENABLED=false
POS_RATE_LIMIT_REQUESTS_PER_MINUTE=
POS_AUTH_FAILURE_LIMIT=
POS_AUTH_FAILURE_WINDOW_SECONDS=
POS_CATALOG_CHANGE_RETENTION_DAYS=
POS_OFFLINE_SALE_REVIEW_AFTER_MINUTES=

# Website print queue. Use `compatibility` only during an explicit legacy
# printer cutover window; use `required` for staging and the final state.
PRINT_API_AUTH_MODE=
PRINT_TOKEN_PEPPER=
PRINT_CLIENT_AUTH_READY=false
PRINT_DEPLOYMENT_TARGET=local
PRINT_STAGING_BASE_URL=https://staging.example.invalid
PRINT_PRODUCTION_BASE_URL=https://example.invalid
PRINT_PRODUCTION_ROLLOUT_ACK=
PRINT_RATE_LIMIT_REQUESTS_PER_MINUTE=
PRINT_AUTH_FAILURE_LIMIT=
PRINT_AUTH_FAILURE_WINDOW_SECONDS=
MELIPAYAMAK_SHARED_URL=
APPOINTMENT_SMS_RETURN_READY_BODY_ID=
APPOINTMENT_SMS_HANDED_TO_COURIER_BODY_ID=
APPOINTMENT_SMS_DELIVERED_BODY_ID=

# GA4 Web stream (public measurement ID; configure on the server before build)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-SKKTF5CHSP

# Separate account for game covers. Never use product/blog Cloudinary keys here.
GAME_CLOUDINARY_CLOUD_NAME=aeylqy7h
GAME_CLOUDINARY_API_KEY=
GAME_CLOUDINARY_API_SECRET=

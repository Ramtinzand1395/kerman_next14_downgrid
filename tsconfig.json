{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "forceConsistentCasingInFileNames": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    "next.config.js"
, "app/api/seed/route.js", "app/(public)/components/.HerobACKUP.tsx", "app/(public)/components/.CategoriesBackup.tsx", "app/(public)/components/landing/.UsersCommentsBackup.tsx", "app/(public)/.FooterBackup.tsx", "app/(dashboard)/dashboard/orders/.pageإشزنعح.tsx", "app/(public)/my-profile/.pageBackup.tsx", "app/(public)/my-profile/.StepperBackup.tsx", "app/(public)/my-profile/.SidebarBackup.tsx", "app/(public)/my-profile/.MyCommentsBackup.tsx", "app/(public)/my-profile/.FavoritesBackup.tsx", "app/(public)/my-profile/.ProfileBackup.tsx", "app/(public)/my-profile/.MyAddressesBackup.tsx", "app/(dashboard)/dashboard/inbox/.pageBackup.tsx", "app/(dashboard)/dashboard/.pageBackup.tsx", "app/(dashboard)/dashboard/components/.DashboardSidebarBackup.tsx", "app/(public)/products/.pageBackup.tsx", "app/(public)/products/components/.SortProductsBackup.tsx", "app/(public)/products/components/.PaginationBackup.tsx", "app/(public)/products/components/.FilterProductsBackup.tsx", "app/(dashboard)/dashboard/products/.pageBackup.tsx", "app/(dashboard)/dashboard/users/.pageBackup.tsx", "app/(public)/product/[slug]/.pageBackup.tsx"  ],
  "exclude": [
    "node_modules"
  ]
}
